function updatePlayerNames()
    if not PlayerESPEnabled then return end
    
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player ~= game:GetService("Players").LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head and not head:FindFirstChild("PlayerNameESP") then
                addPlayerName(player, player.Character)
            end
        end
    end
end

function removePlayerNames()
    for player, billboard in pairs(nameESPs) do
        if billboard then
            billboard:Destroy()
        end
    end
    nameESPs = {}
    
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player.Character then
            local head = player.Character:FindFirstChild("Head")
            if head then
                local billboard = head:FindFirstChild("PlayerNameESP")
                if billboard then
                    billboard:Destroy()
                end
            end
        end
    end
end

-- Box ESP Functions
function updateBoxESP()
    if not PlayerESPEnabled then return end
    
    local Players = game:GetService("Players")
    local Camera = workspace.CurrentCamera
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character then
            if not boxESPs[player] then
                createBoxForPlayer(player)
            end
        end
    end
end

function createBoxForPlayer(player)
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = ESPOutlineColor
    box.Thickness = 2
    box.Transparency = 1
    box.Filled = false
    
    boxESPs[player] = box
end

function removeBoxESP()
    for player, box in pairs(boxESPs) do
        if box then
            box:Remove()
        end
    end
    boxESPs = {}
end

-- Tracers Functions
function updateTracers()
    if not PlayerESPEnabled then return end
    
    local Players = game:GetService("Players")
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer and player.Character then
            if not tracerESPs[player] then
                createTracerForPlayer(player)
            end
        end
    end
end

function createTracerForPlayer(player)
    local line = Drawing.new("Line")
    line.Visible = false
    line.Color = ESPOutlineColor
    line.Thickness = 2
    line.Transparency = 1
    
    tracerESPs[player] = line
