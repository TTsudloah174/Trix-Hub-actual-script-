-- Lock On Functions
function enableLockOn()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    local Camera = workspace.CurrentCamera
    
    -- Create mobile UI button
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local lockOnButton = nil
    
    if isMobile then
        local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
        
        -- Create mobile lock on button
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "LockOnMobileUI"
        screenGui.ResetOnSpawn = false
        screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screenGui.Parent = PlayerGui
        
        local button = Instance.new("ImageButton")
        button.Name = "LockOnButton"
        button.Size = UDim2.new(0, 60, 0, 60)
        button.Position = UDim2.new(1, -80, 0.5, -30)
        button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        button.BackgroundTransparency = 0.3
        button.BorderSizePixel = 0
        button.Image = "rbxassetid://73466246454364"
        button.Parent = screenGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = button
        
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Thickness = 2
        stroke.Transparency = 0.5
        stroke.Parent = button
        
        -- Create lock button for mobile UI
        local lockButton = Instance.new("TextButton")
        lockButton.Name = "LockButton"
        lockButton.Size = UDim2.new(0, 30, 0, 30)
        lockButton.Position = UDim2.new(0, -35, 0, 15)
        lockButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        lockButton.BackgroundTransparency = 0.3
        lockButton.BorderSizePixel = 0
        lockButton.Text = "🔓"
        lockButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        lockButton.TextSize = 16
        lockButton.Font = Enum.Font.GothamBold
        lockButton.Parent = button
        
        local lockCorner = Instance.new("UICorner")
        lockCorner.CornerRadius = UDim.new(1, 0)
        lockCorner.Parent = lockButton
        
        local lockStroke = Instance.new("UIStroke")
        lockStroke.Color = Color3.fromRGB(255, 255, 255)
        lockStroke.Thickness = 2
        lockStroke.Transparency = 0.5
        lockStroke.Parent = lockButton
        
        lockOnButton = button
        
        -- Lock/Unlock functionality
        local isLocked = false
        
        lockButton.MouseButton1Click:Connect(function()
            isLocked = not isLocked
            if isLocked then
                lockButton.Text = "🔒"
                lockButton.BackgroundColor3 = Color3.fromRGB(60, 20, 20)
                button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            else
                lockButton.Text = "🔓"
                lockButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            end
        end)
        
        -- Make draggable (only when unlocked)
        local dragging = false
        local dragStart = nil
        local startPos = nil
        local dragThreshold = 10 -- pixels to detect drag vs click
        
        button.InputBegan:Connect(function(input)
            if isLocked then return end
            if input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                dragStart = input.Position
                startPos = button.Position
            end
        end)
        
        button.InputChanged:Connect(function(input)
            if isLocked then return end
            if dragStart and input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                local dragDistance = delta.Magnitude
                
                -- Only start dragging if moved more than threshold
                if dragDistance > dragThreshold then
                    dragging = true
                    button.Position = UDim2.new(
                        startPos.X.Scale,
                        startPos.X.Offset + delta.X,
                        startPos.Y.Scale,
                        startPos.Y.Offset + delta.Y
                    )
                end
            end
        end)
        
        button.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then
                local wasDragging = dragging
                dragging = false
                dragStart = nil
                
                -- Only toggle lock if it wasn't a drag
                if not wasDragging and not isLocked then
                    toggleLockOnTarget()
                elseif isLocked then
                    toggleLockOnTarget()
                end
            end
        end)
    end
    
    -- PC keybind
    local keybindConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        -- Convert string keybind to KeyCode enum
        local keyCodeEnum = Enum.KeyCode[LockOnKeybind]
        if keyCodeEnum and input.KeyCode == keyCodeEnum then
            toggleLockOnTarget()
        end
    end)
    
    -- Update loop for lock on
    local updateConn = RunService.RenderStepped:Connect(function()
        if not LockOnEnabled then return end
        
        if LockOnTarget and LockOnTarget.Character then
            local targetRoot = LockOnTarget.Character:FindFirstChild("HumanoidRootPart")
            local targetHead = LockOnTarget.Character:FindFirstChild("Head")
            local targetHumanoid = LockOnTarget.Character:FindFirstChild("Humanoid")
            
            if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                -- Aimbot - make character AND camera face target
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                    local myRoot = character.HumanoidRootPart
                    local myHumanoid = character.Humanoid
                    
                    -- Only aim if not dead
                    if myHumanoid.Health > 0 then
                        local aimTarget = targetHead or targetRoot
                        
                        -- Make character face target
                        local directionToTarget = (Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z) - myRoot.Position).Unit
                        myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position + directionToTarget)
                        
                        -- Make camera look at target
                        local lookVector = (aimTarget.Position - Camera.CFrame.Position).Unit
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookVector)
                    end
                end
                
                -- Update decal position
                if LockOnDecal and LockOnDecal.Parent then
                    LockOnDecal.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
                end
            else
                -- Target died or invalid
                clearLockOnTarget()
            end
        end
    end)
    
    LockOnConnection = {keybindConn, updateConn, lockOnButton}
end

function disableLockOn()
    clearLockOnTarget()
    
    if LockOnConnection then
        for _, conn in pairs(LockOnConnection) do
            if conn then
                if typeof(conn) == "RBXScriptConnection" then
                    conn:Disconnect()
                elseif typeof(conn) == "Instance" then
                    local parent = conn.Parent
                    if parent then
                        parent:Destroy()
                    end
                end
            end
        end
        LockOnConnection = nil
    end
end

function toggleLockOnTarget()
    if LockOnTarget then
        clearLockOnTarget()
    else
        setLockOnTarget()
    end
end

function setLockOnTarget()
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Camera = workspace.CurrentCamera
    
    local nearestPlayer = nil
    local nearestDistance = math.huge
    local nearestScreenDist = math.huge
    
    -- Find nearest player to crosshair
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = player.Character:FindFirstChild("Humanoid")
            
            if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
                
                if onScreen then
                    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    
                    if screenDist < nearestScreenDist then
                        nearestScreenDist = screenDist
                        nearestPlayer = player
                    end
                end
            end
        end
    end
    
    if nearestPlayer then
        LockOnTarget = nearestPlayer
        
        -- Create decal indicator
        local targetRoot = nearestPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local part = Instance.new("Part")
            part.Name = "LockOnIndicator"
            part.Size = Vector3.new(4, 0.1, 4)
            part.Anchored = true
            part.CanCollide = false
            part.Transparency = 1
            part.CFrame = targetRoot.CFrame * CFrame.new(0, 3, 0)
            
            -- Add decal on top
            local decal = Instance.new("Decal")
            decal.Texture = "rbxassetid://262619584"
            decal.Face = Enum.NormalId.Top
            decal.Parent = part
            
            -- Add decal on bottom (visible from below)
            local decalBottom = Instance.new("Decal")
            decalBottom.Texture = "rbxassetid://262619584"
            decalBottom.Face = Enum.NormalId.Bottom
            decalBottom.Parent = part
            
            part.Parent = workspace
            
            LockOnDecal = part
            
            print("Locked onto: " .. nearestPlayer.Name)
        end
    else
        print("No valid target found")
    end
end

function clearLockOnTarget()
    if LockOnTarget then
        print("Unlocked from: " .. LockOnTarget.Name)
    end
    
    LockOnTarget = nil
    
    if LockOnDecal then
        LockOnDecal:Destroy()
        LockOnDecal = nil
    end
end
