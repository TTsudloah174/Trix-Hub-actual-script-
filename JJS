-- Items ESP Functions
function enableItemsESP()
    local workspace = game:GetService("Workspace")
    local itemsFolder = workspace:FindFirstChild("Items")
    
    if not itemsFolder then
        warn("Items ESP: Items folder not found in workspace!")
        return
    end
    
    local function createESP(item)
        if item:IsA("BasePart") or item:IsA("Model") then
            -- Create BillboardGui
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ItemESP"
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 100, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.Adornee = item:IsA("Model") and item.PrimaryPart or item
            billboard.Parent = item
            
            -- Create TextLabel
            local textLabel = Instance.new("TextLabel")
            textLabel.Size = UDim2.new(1, 0, 0.5, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = item.Name
            textLabel.TextColor3 = ESPTextColor
            textLabel.TextSize = 14
            textLabel.FontFace = Font.new("rbxassetid://12187375716", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            textLabel.TextStrokeTransparency = 0.5
            textLabel.Parent = billboard
            
            -- Create distance label
            local distanceLabel = Instance.new("TextLabel")
            distanceLabel.Size = UDim2.new(1, 0, 0.5, 0)
            distanceLabel.Position = UDim2.new(0, 0, 0.5, 0)
            distanceLabel.BackgroundTransparency = 1
            distanceLabel.Text = ""
            distanceLabel.TextColor3 = ESPTextColor
            distanceLabel.TextSize = 12
            distanceLabel.FontFace = Font.new("rbxassetid://12187375716", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
            distanceLabel.TextStrokeTransparency = 0.5
            distanceLabel.Parent = billboard
            
            -- Update distance
            local connection = game:GetService("RunService").RenderStepped:Connect(function()
                if not ItemsESPEnabled or not item.Parent then
                    billboard:Destroy()
                    connection:Disconnect()
                    return
                end
                
                local player = game:GetService("Players").LocalPlayer
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local itemPos = item:IsA("Model") and (item.PrimaryPart and item.PrimaryPart.Position or item:GetModelCFrame().Position) or item.Position
                    local distance = (player.Character.HumanoidRootPart.Position - itemPos).Magnitude
                    distanceLabel.Text = string.format("%.1f studs", distance)
                end
            end)
            
            table.insert(itemESPConnections, connection)
        end
    end
    
    -- Create ESP for existing items
    for _, item in pairs(itemsFolder:GetChildren()) do
        createESP(item)
    end
    
    -- Create ESP for new items
    local connection = itemsFolder.ChildAdded:Connect(function(item)
        if ItemsESPEnabled then
            task.wait(0.1)
            createESP(item)
        end
    end)
    
    table.insert(itemESPConnections, connection)
end

function disableItemsESP()
    -- Disconnect all connections
    for _, connection in pairs(itemESPConnections) do
        if connection then
            connection:Disconnect()
        end
    end
    itemESPConnections = {}
    
    -- Remove all ESP billboards
    local workspace = game:GetService("Workspace")
    local itemsFolder = workspace:FindFirstChild("Items")
    
    if itemsFolder then
        for _, item in pairs(itemsFolder:GetDescendants()) do
            if item:IsA("BillboardGui") and item.Name == "ItemESP" then
                item:Destroy()
            end
        end
    end
end

